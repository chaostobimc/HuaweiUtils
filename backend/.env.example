# DeepSeek Token - holen via:
# 1. https://chat.deepseek.com einloggen
# 2. F12 Console: JSON.parse(localStorage.getItem("userToken")).value
DEEPSEEK_USER_TOKEN=eyJ...

# Optional Tuning (Akku/Daten sparen)
MAX_PROMPT_LEN=500
MAX_RESPONSE_LEN=800
ENABLE_THINKING=true
ENABLE_SEARCH=false
RATE_LIMIT_SECONDS=1.5
CACHE_TTL=0

# Für Cloudflare Bypass (falls nötig):
# Nach erstem Start: docker exec -it huawei-ai-bridge python -m dsk.bypass
# Dann cookies.json nach ./data kopieren
